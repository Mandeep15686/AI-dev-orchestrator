{
  "$schema":  "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "AI Dev Orchestrator",
  "version":  "0.1.0",
  "identifier": "dev.ai-orch.orchestrator",
  "build": {
    "beforeDevCommand":   "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl":   "http://localhost:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label":          "main",
        "title":          "AI Dev Orchestrator",
        "width":          1400,
        "height":         900,
        "minWidth":       960,
        "minHeight":      600,
        "resizable":      true,
        "fullscreen":     false,
        "decorations":    true,
        "transparent":    false,
        "center":         true,
        "theme":          "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active":  true,
    "targets": "all"
  },
  "plugins": {
    "shell": {
      "all":   false,
      "open":  true,
      "scope": []
    },
    "fs": {
      "all":   false,
      "scope": ["$HOME/**", "$DOCUMENT/**"]
    }
  }
}
